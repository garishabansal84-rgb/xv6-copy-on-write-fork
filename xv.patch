+while (getcmd(buf, sizeof(buf)) >= 0) {
+  char *cmd = buf;
+
+  while (*cmd == ' ' || *cmd == '\t')
+    cmd++;
+
+  if (*cmd == '\n')
+    continue;
+
+  // Remove the newline from the command
+  if (cmd[strlen(cmd) - 1] == '\n')
